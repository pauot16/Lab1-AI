# ========================================
# Unity.gitignore (Optimizado)
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# ========================================

# === Carpetas generadas automáticamente por Unity ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
UserSettings/
MemoryCaptures/
Recordings/
Logs/

# === Addressables y StreamingAssets (temporales o generados) ===
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# === Configuración de IDEs ===
.vscode/
.idea/
.vs/
.gradle/
ExportedObj/
.consulo/

# === Archivos de solución y proyectos generados ===
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# === Metadatos y compilaciones ===
*.pdb
*.mdb
*.pdb.meta
*.mdb.meta
*.pidb.meta

# === Archivos temporales o de diagnóstico ===
sysinfo.txt

# === Builds exportadas ===
*.apk
*.aab
*.unitypackage
*.app

# === Firebase Crashlytics ===
crashlytics-build.properties

# === Rider ===
[Aa]ssets/Plugins/Editor/JetBrains*

# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log
GameJam2026/fmod_editor.log
/GameJam2026/Assets/Plugins/FMOD/Cache

# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log
/GameJam2026/Assets/Plugins/FMOD/Cache
/GameJam2026/fmod/.cache
